# ==============================================================================
# Asset & Equipment Management System - Template Environment (.env.example)
# ==============================================================================

# Database Configuration
POSTGRES_DB=assetdb
POSTGRES_USER=asset_app
POSTGRES_PASSWORD=example_postgres_strong_password_change_me
POSTGRES_PORT=5432

# Web Application
PORT=3000
NODE_ENV=production
SESSION_SECRET=example_session_secret_at_least_32_characters_long

# pgAdmin 4
PGADMIN_DEFAULT_EMAIL=admin@asset.local
PGADMIN_DEFAULT_PASSWORD=example_pgadmin_strong_password_change_me
PGADMIN_CONFIG_SERVER_MODE=False

# Prometheus & Grafana (for later steps)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=example_grafana_strong_password_change_me