  "panels": [
    {
      "id": 1,
      "title": "Active Client Connections",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"assetdb\"}",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Database Size",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"assetdb\"}",
          "legendFormat": "assetdb size",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cache Hit Ratio (%)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 85
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "((sum(rate(pg_stat_database_blks_hit{datname=\"assetdb\"}[1m])) or vector(1)) / ((sum(rate(pg_stat_database_blks_hit{datname=\"assetdb\"}[1m])) + sum(rate(pg_stat_database_blks_read{datname=\"assetdb\"}[1m]))) or vector(1))) * 100",
          "legendFormat": "Hit Ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Transactions per Second (Commit vs Rollback)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "tps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"assetdb\"}[1m])",
          "legendFormat": "Commits/s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"assetdb\"}[1m])",
          "legendFormat": "Rollbacks/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tuples Returned / Fetched / Inserted / Updated (per sec)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_returned{datname=\"assetdb\"}[1m])",
          "legendFormat": "Tuples Returned",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_tup_fetched{datname=\"assetdb\"}[1m])",
          "legendFormat": "Tuples Fetched",
          "refId": "B"
        },
        {
          "expr": "rate(pg_stat_database_tup_inserted{datname=\"assetdb\"}[1m])",
          "legendFormat": "Tuples Inserted",
          "refId": "C"
        },
        {
          "expr": "rate(pg_stat_database_tup_updated{datname=\"assetdb\"}[1m])",
          "legendFormat": "Tuples Updated",
          "refId": "D"
        }
      ]
    }
  ],
