<%- include('../partials/header') %>

<div class="card" style="max-width: 440px; margin: 3rem auto;">
  <div class="card-header" style="justify-content: center; background: #0f172a; color: #fff; padding: 1.5rem;">
    <div style="text-align: center;">
      <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 0.25rem;">Đăng Nhập</h2>
      <p style="font-size: 0.85rem; color: #94a3b8;">Hệ thống Quản lý Tài sản & Thiết bị</p>
    </div>
  </div>

  <div class="card-body" style="padding: 1.75rem;">
    <% if (error) { %>
      <div style="background-color: #fee2e2; border-left: 4px solid #ef4444; color: #991b1b; padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1.25rem; font-size: 0.9rem;">
        <%= error %>
      </div>
    <% } %>

    <% if (registered) { %>
      <div style="background-color: #d1fae5; border-left: 4px solid #10b981; color: #065f46; padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1.25rem; font-size: 0.9rem;">
        Đăng ký tài khoản thành công! Vui lòng đăng nhập.
      </div>
    <% } %>

    <form action="/auth/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label class="form-label" for="username">Tên đăng nhập</label>
        <input type="text" id="username" name="username" class="form-control" value="<%= username || '' %>" required autofocus placeholder="Ví dụ: admin, thukho01, nhanvien01">
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Mật khẩu</label>
        <input type="password" id="password" name="password" class="form-control" required placeholder="Nhập mật khẩu của bạn">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; margin-top: 0.5rem;">
        Đăng Nhập Hệ Thống
      </button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.9rem; color: #64748b;">
      Chưa có tài khoản? <a href="/auth/register" style="font-weight: 600;">Đăng ký tài khoản nhân viên</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>