<%- include('../partials/header') %>

<div class="card" style="max-width: 520px; margin: 2rem auto;">
  <div class="card-header" style="justify-content: center; background: #0f172a; color: #fff; padding: 1.5rem;">
    <div style="text-align: center;">
      <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 0.25rem;">Đăng Ký Tài Khoản</h2>
      <p style="font-size: 0.85rem; color: #94a3b8;">Dành cho cán bộ, giảng viên và sinh viên (Vai trò: Employee)</p>
    </div>
  </div>

  <div class="card-body" style="padding: 1.75rem;">
    <% if (error) { %>
      <div style="background-color: #fee2e2; border-left: 4px solid #ef4444; color: #991b1b; padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1.25rem; font-size: 0.9rem;">
        <%= error %>
      </div>
    <% } %>

    <form action="/auth/register" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label class="form-label" for="full_name">Họ và tên đầy đủ</label>
        <input type="text" id="full_name" name="full_name" class="form-control" value="<%= formData.full_name || '' %>" required placeholder="Nguyễn Văn A">
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="username">Tên đăng nhập</label>
          <input type="text" id="username" name="username" class="form-control" value="<%= formData.username || '' %>" required placeholder="username">
        </div>
        <div class="form-group">
          <label class="form-label" for="department">Đơn vị / Phòng ban</label>
          <input type="text" id="department" name="department" class="form-control" value="<%= formData.department || '' %>" required placeholder="Khoa CNTT">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="email">Địa chỉ Email</label>
        <input type="email" id="email" name="email" class="form-control" value="<%= formData.email || '' %>" required placeholder="user@domain.edu.vn">
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="password">Mật khẩu</label>
          <input type="password" id="password" name="password" class="form-control" required placeholder="Tối thiểu 6 ký tự">
        </div>
        <div class="form-group">
          <label class="form-label" for="confirm_password">Xác nhận mật khẩu</label>
          <input type="password" id="confirm_password" name="confirm_password" class="form-control" required placeholder="Nhập lại mật khẩu">
        </div>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; margin-top: 0.5rem;">
        Đăng Ký Tài Khoản
      </button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.9rem; color: #64748b;">
      Đã có tài khoản? <a href="/auth/login" style="font-weight: 600;">Đăng nhập ngay</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>