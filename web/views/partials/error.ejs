<%- include('../partials/header') %>

<div class="card" style="max-width: 600px; margin: 3rem auto; text-align: center;">
  <div class="card-body" style="padding: 3rem 2rem;">
    <div style="font-size: 3.5rem; font-weight: 800; color: #ef4444; margin-bottom: 1rem;">
      <%= typeof statusCode !== 'undefined' ? statusCode : '500' %>
    </div>
    <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: #0f172a;">
      <%= typeof title !== 'undefined' ? title : 'Đã xảy ra lỗi' %>
    </h2>
    <p style="color: #64748b; margin-bottom: 2rem; font-size: 1rem; line-height: 1.6;">
      <%= typeof message !== 'undefined' ? message : 'Yêu cầu không thể hoàn thành.' %>
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center;">
      <a href="javascript:history.back()" class="btn btn-secondary">Quay lại trang trước</a>
      <a href="/assets" class="btn btn-primary">Về danh mục tài sản</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>